---
import Layout from '../../layouts/Layout.astro';
import CtaBlack from '../../components/CtaBlack.astro';
import Footer from '../../components/Footer.astro';
import { POSTS } from '../../data/content';
export function getStaticPaths() { return POSTS.map((p) => ({ params: { slug: p.slug }, props: { p } })); }
const { p } = Astro.props;
---
<Layout title={`${p.title} | The West Side Studios`} description={p.excerpt} namespace={`post-${p.slug}`}>
  <section class="bg-black px-6 pb-16 pt-[100px] text-white lg:px-12 lg:pb-24 lg:pt-[176px]">
    <div class="mx-auto flex max-w-[1216px] flex-col gap-6 lg:gap-10">
      <span class="font-[Geist_Mono] text-[12px] uppercase leading-[120%] tracking-[-0.01em] text-white/60">{p.read} · {p.date}</span>
      <h1 data-reveal-entry class="font-[Geist] font-normal text-[32px] leading-[104%] tracking-[-0.01em] md:text-[44px] lg:max-w-[820px] lg:text-[56px]">{p.title}</h1>
      <p class="font-[Geist] font-normal text-[16px] leading-[130%] tracking-[-0.01em] text-white/70 lg:max-w-[420px] lg:self-end">{p.excerpt}</p>
    </div>
  </section>
  <div class="bg-black px-6 pb-6 lg:px-12 lg:pb-12">
    <div class="mx-auto max-w-[1216px] overflow-hidden rounded-[8px]" style={`background:${p.bg}`}><img src={p.img} alt="" class="w-full h-auto" /></div>
  </div>
  <article class="bg-white px-6 py-20 text-black lg:py-32">
    <div class="prose-post mx-auto max-w-[680px] font-[Geist] text-[18px] leading-[1.6] tracking-[-0.01em] text-[#191919]">
      {p.body.map((para) => <p data-reveal>{para}</p>)}
      <p class="mt-12 font-[Geist_Mono] text-[12px] uppercase text-[#666]">Written by {p.author}</p>
    </div>
  </article>
  <CtaBlack title="Let’s build something great together." text="We work with ambitious teams to create brands, websites and products that help businesses move forward." />
  <Footer />
</Layout>
