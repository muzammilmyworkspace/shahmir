---
import Layout from '../layouts/Layout.astro';
import { SITE } from '../data/content';
const name = 'Shahmir Hashmat';
const principles = [
  { n: '01', t: 'Clarity beats noise.', d: 'If a customer can’t repeat it, it doesn’t exist. Every brand starts with one sentence that is impossible to misunderstand.' },
  { n: '02', t: 'Story sells. Specs don’t.', d: 'People buy the why before the what. We find the story inside the business and tell it everywhere.' },
  { n: '03', t: 'Speed, with standards.', d: 'Move fast, but never ship anything you wouldn’t put your own name on.' },
  { n: '04', t: 'Build for the long game.', d: 'Trends fade. Trust compounds. The goal is a brand people still choose in ten years.' },
];
const manifesto = 'Most brands are built to be seen. I build brands to be [remembered]. Strategy first, [story] always, and the discipline to see it through until the market [listens].';
const words = manifesto.split(' ').map((w) => ({ hl: w.startsWith('['), t: w.replace(/[\[\]]/g, '') }));
---
<Layout namespace="home" title={`${name} | Founder, The West Side Studios`} description={`${name} — founder of The West Side Studios and The Sourcers. Building brands people remember.`}>
  <div class="f-loader" aria-hidden="true">
    <div class="f-loader-name">{'SHAHMIR'.split('').map((c) => <span>{c}</span>)}</div>
    <div class="f-loader-meta"><span>Founder · The West Side Studios</span><b data-count>00</b></div>
    <i class="f-loader-bar"></i>
  </div>
  <div class="f-cursor" aria-hidden="true"><span></span><em>View</em></div>

  <section class="f-journey" id="top">
    <div class="f-stage">
      <div class="f-hero-bg" aria-hidden="true"></div>
      <svg class="f-arcs" viewBox="-500 -500 1000 1000" aria-hidden="true">
        {Array.from({ length: 9 }, (_, i) => <circle r={170 + i * 38} fill="none" stroke-dasharray={i % 3 === 0 ? '2 10' : i % 3 === 1 ? '60 14' : ''} />)}
      </svg>
      <div class="f-sun" aria-hidden="true"></div>
      <h1 class="f-name" aria-label={name}><span class="f-name-l">SHAH</span><span class="f-name-r">MIR</span></h1>

      <div class="f-figure" aria-hidden="true">
        <div class="f-par">
          <img class="f-pose f-pose-a" src="/shahmir/shahmir.webp" alt="" />
          <img class="f-pose f-pose-b" src="/shahmir/shahmir.webp" alt="" />
        </div>
      </div>

      <!-- 0 · cover -->
      <div class="f-step f-cover" data-step="0">
        <div class="f-cover-top">
          <span class="f-issue">Issue 01 — The Founder</span>
          <span class="f-cover-roles">Brand builder<br />Strategist<br />Operator</span>
        </div>
        <div class="f-cover-bottom">
          <p class="f-cover-line" data-split>I build brands<br /><em>people can’t ignore.</em></p>
          <div class="f-cover-side">
            <p>{name} is the founder of <b>The West Side Studios</b> and <b>The Sourcers</b>.</p>
            <a href="#contact" class="f-btn" data-magnetic>Work with me <span>↗</span></a>
          </div>
        </div>
        <div class="f-scrollcue"><i></i>Scroll</div>
      </div>

      <!-- 1 · manifesto (figure right) -->
      <div class="f-step f-manifesto" data-step="1" id="story">
        <p class="f-label">The manifesto</p>
        <p class="f-manifesto-text">{words.map((w) => <span class:list={['w', w.hl && 'hl']}>{w.t} </span>)}</p>
      </div>

      <!-- 2 · the founder (figure left) -->
      <div class="f-step f-founder" data-step="2" id="founder">
        <p class="f-label">The founder</p>
        <h2>Hi, I’m Shahmir.<br /><em>I turn businesses into brands.</em></h2>
        <p class="f-lead">I started my first company because I believed great products deserve great stories. Today I run two: a creative studio that builds brands, and a sourcing company that helps ecommerce founders build better products.</p>
        <ul class="f-roles">
          <li><span>Founder</span><b>The West Side Studios</b></li>
          <li><span>Founder &amp; CEO</span><b>The Sourcers</b></li>
        </ul>
        <p class="f-sign">Shahmir</p>
      </div>

      <!-- 3 · how I work (figure centre, cards left & right) -->
      <div class="f-step f-how" data-step="3" id="philosophy">
        <div class="f-how-head"><p class="f-label">How I work</p><h2>Four rules <em>I don’t break.</em></h2></div>
        {principles.map((p, i) => (
          <article class={`f-rule f-rule-${i}`}>
            <span class="f-rule-n">{p.n}</span>
            <h3>{p.t}</h3>
            <p>{p.d}</p>
          </article>
        ))}
      </div>

      <!-- 4 · the promise (figure dimmed) -->
      <div class="f-step f-promise" data-step="4">
        <p class="f-label">The promise</p>
        <blockquote><p>“A brand is a promise<br /><em>you keep in public.</em>”</p><footer>— {name}</footer></blockquote>
      </div>

      <!-- 5 · work with me (figure left) -->
      <div class="f-step f-work" data-step="5" id="contact">
        <p class="f-label">Work with me</p>
        <h2>Have a brand<br /><em>worth building?</em></h2>
        <p class="f-lead">Tell me where your business is today and where you want it to be. I reply to every serious enquiry personally.</p>
        <div class="f-work-row">
          <a href="/contact" class="f-btn f-btn-lg" data-magnetic>Start a conversation <span>↗</span></a>
          <a href={`mailto:${SITE.email}`} class="f-mail">{SITE.email}</a>
        </div>
      </div>

    </div>
  </section>

  <footer class="f-footer">
    <div class="f-footer-marquee" aria-hidden="true"><div class="f-footer-track">{[0, 1, 2].map(() => <span>SHAHMIR HASHMAT <i>✦</i> </span>)}</div></div>
    <div class="f-footer-row">
      <span>© 2026 {name}</span>
      <nav><a href="#story">Story</a><a href="#philosophy">Principles</a><a href="#contact">Work with me</a><a href="/contact">Contact</a></nav>
      <a href="#top" class="f-top">Back to top ↑</a>
    </div>
  </footer>
</Layout>
