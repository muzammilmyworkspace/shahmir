---
import Layout from '../../layouts/Layout.astro';
import CtaBlack from '../../components/CtaBlack.astro';
import Footer from '../../components/Footer.astro';
import { PROJECTS } from '../../data/content';
export function getStaticPaths() { return PROJECTS.map((p) => ({ params: { slug: p.slug }, props: { p: p } })); }
const { p } = Astro.props;
const isVideo = (s: string) => s.endsWith('.mp4');
---
<Layout title={`${p.client} | The West Side Studios`} namespace={`project-${p.slug}`}>
  <section class="case-hero flex flex-col bg-black text-white px-8 pt-[100px] pb-[40px] lg:grid lg:min-h-[535px] lg:pt-[152px] lg:pb-[72px]">
    <span class="area-client font-[Geist] font-normal text-sm leading-[1.04] tracking-[-0.01em] mb-6 lg:mb-0">{p.client}</span>
    <h1 data-reveal-entry class="area-title font-[Geist] font-normal text-[40px] md:text-[60px] lg:text-[80px] leading-[1.04] tracking-[-0.01em] mb-8 lg:mb-0">{p.title}</h1>
    <div class="area-details flex justify-between lg:pt-12 font-[Geist_Mono] font-normal text-[12px] leading-[1.2] tracking-[-0.01em] uppercase text-white">
      <span>{p.category}</span><span>{p.year}</span><span>{p.services}</span>
    </div>
  </section>
  <div class="bg-black px-6 pb-6 lg:px-8 lg:pb-12">
    <img src={p.cover} alt={p.client} class="w-full h-auto rounded-[8px]" />
  </div>
  <section class="case-overview flex flex-col bg-white text-black px-8 pt-[60px] pb-[40px] lg:grid lg:min-h-[535px] lg:pt-[120px] lg:pb-[84px]">
    <div class="area-line h-[1px] bg-black"></div>
    <span class="area-client pt-6 font-[Geist] font-normal text-[24px] lg:text-[32px] leading-[1.2] tracking-[-0.01em] mb-6 lg:mb-0 lg:max-w-[76px]">Project overview</span>
    <h2 data-reveal class="area-title pt-6 font-[Geist] font-normal text-[32px] lg:text-[48px] leading-[1.2] tracking-[-0.01em] text-black mb-6 lg:mb-0">{p.overviewTitle}</h2>
    <p class="area-text text-[#666666]">{p.overview}</p>
  </section>
  {p.video && (
    <section class="bg-white"><div class="px-0 py-0 md:py-[60px] md:px-[24px] lg:py-[120px] lg:px-[32px]">
      <video src={p.video} poster={p.poster} autoplay muted loop playsinline preload="metadata" data-autoplay-in-view class="w-full h-full object-cover md:rounded-[8px]"></video>
    </div></section>
  )}
  <section class="flex flex-col items-center bg-white text-black px-6 md:px-8 lg:px-0">
    <div class="w-full max-w-[538px]">
      <h2 class="font-geist font-normal text-[24px] md:text-[28px] lg:text-[32px] leading-[1.2] tracking-[-0.01em] text-center">What we did</h2>
      <p data-reveal class="pt-5 pb-6 md:pt-6 md:pb-7 lg:pt-7 lg:pb-8 font-geist font-normal text-[32px] md:text-[40px] lg:text-[48px] leading-[1.2] tracking-[-0.01em] text-center">{p.whatTitle}</p>
      <p class="font-geist font-normal text-sm md:text-base leading-[1.3] tracking-[-0.01em] text-center">{p.what}</p>
    </div>
  </section>
  <div class="bg-white flex flex-col gap-4 px-6 lg:px-8 pt-[60px] lg:pt-[152px] pb-[60px] lg:pb-[120px]">
    {p.gallery.map((row) => Array.isArray(row) ? (
      <section class="flex flex-col md:flex-row w-full gap-4">
        {row.map((src) => <div class="w-full md:w-1/2">{isVideo(src)
          ? <video src={src} autoplay data-autoplay-in-view muted loop playsinline preload="metadata" class="w-full h-auto md:h-[869px] md:object-cover rounded-[8px]"></video>
          : <img src={src} alt="" loading="lazy" class="w-full h-auto md:h-[869px] object-cover rounded-[8px]" />}</div>)}
      </section>
    ) : (
      <section class="w-full">{isVideo(row)
        ? <video src={row} autoplay data-autoplay-in-view muted loop playsinline preload="metadata" class="w-full h-auto md:h-[869px] md:object-cover rounded-[8px]"></video>
        : <img src={row} alt="" loading="lazy" class="w-full h-auto md:h-[869px] object-cover rounded-[8px]" />}</section>
    ))}
  </div>
  {p.link && (
    <section class="flex flex-col items-center justify-center bg-primary text-white min-h-screen px-6 md:px-12 lg:px-0">
      <div class="w-full max-w-[548px] text-center">
        <span class="font-[Geist_Mono] font-normal text-[12px] tracking-[-0.01em] leading-[1.2] uppercase">Live project</span>
        <p data-reveal class="pt-8 pb-6 md:pt-10 md:pb-7 lg:pt-12 lg:pb-8 font-geist font-normal text-[20px] md:text-[24px] lg:text-[28px] leading-[1.3] tracking-[-0.01em]">{p.short}</p>
        <a href={p.link} target="_blank" rel="noopener" class="font-geist font-normal text-[14px] leading-[1.04] tracking-[-0.01em] underline underline-offset-4">{p.link.replace('https://', '')}</a>
      </div>
    </section>
  )}
  <CtaBlack title="Let’s build something great together." text="We work with ambitious teams to create brands, websites and products that help businesses move forward." />
  <Footer />
</Layout>
