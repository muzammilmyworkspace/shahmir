};
---
<ul class="f-socials">
  {SOCIALS.map((s) => (
    <li><a href={s.href} target="_blank" rel="noopener" aria-label={s.label} data-barba-prevent><svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.6" set:html={icons[s.label]} /></a></li>
  ))}
</ul>
