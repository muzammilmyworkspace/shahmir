  LinkedIn: '<path d="M4 9.5h3.2V20H4zM5.6 4a1.85 1.85 0 1 1 0 3.7 1.85 1.85 0 0 1 0-3.7zM9.8 9.5h3.1v1.5c.5-.9 1.7-1.8 3.4-1.8 3.4 0 4 2.2 4 5.1V20h-3.2v-5c0-1.2 0-2.8-1.7-2.8s-2 1.3-2 2.7V20H9.8z" fill="currentColor" stroke="none"/>',
  Facebook: '<path d="M13.6 21v-7.6h2.6l.4-3h-3V8.5c0-.9.3-1.5 1.5-1.5h1.6V4.3c-.3 0-1.2-.1-2.3-.1-2.3 0-3.9 1.4-3.9 4v2.2H7.9v3h2.6V21z" fill="currentColor" stroke="none"/>',
  TikTok: '<path d="M16.6 3c.3 2.2 1.6 3.6 3.9 3.8v3.1c-1.4.1-2.6-.3-3.9-1.1v5.6c0 7.1-7.8 9.3-10.9 4.2-2-3.3-.8-9.1 5.6-9.3v3.3c-.5.1-1 .2-1.5.4-1.4.5-2.2 1.4-2 3 .4 3.1 6.2 4 5.7-2V3z" fill="currentColor" stroke="none"/>',
