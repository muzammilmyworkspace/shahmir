---
import PillGlass from './PillGlass';
import { NAV } from '../data/content';
const link = 'header-link font-[Geist] text-[14px] font-normal leading-[1.12] tracking-[-0.01em] text-center opacity-100 transition-all duration-200 hover:opacity-60';
---
<header id="site-header" class="fixed top-0 left-0 right-0 z-50 flex justify-center">
  <div id="header-pill" class="flex w-full items-center justify-between px-8 py-5">
    <div class="pill-glass"><PillGlass client:idle /></div>
    <nav class="pill-item hidden gap-12 cursor-pointer md:flex">
      {NAV.left.map((l) => <a href={l.href} class={link}>{l.label}</a>)}
    </nav>
    <a href="/" class="pill-item shrink-0" aria-label="The West Side Studios home">
      <img src="/wordmark.svg" alt="westside" class="header-logo" style="height:16px;width:auto;" />
    </a>
    <div class="pill-item hidden items-center gap-12 md:flex">
      <nav class="flex gap-12 cursor-pointer items-center">
        {NAV.right.map((l) => <a href={l.href} class={link}>{l.label}</a>)}
      </nav>
      <a href="/contact" class="header-cta">Let’s talk</a>
      <button id="menu-btn-desktop" type="button" class="header-link cursor-pointer transition-opacity hover:opacity-60" aria-label="Open menu">
        <svg id="icon-menu-desktop" width="16" height="12" viewBox="0 0 16 12" fill="none" stroke="currentColor" stroke-width="1.4"><path d="M0 1h16M0 6h16M0 11h16" /></svg>
        <svg id="icon-close-desktop" class="hidden" width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.4"><path d="M1 1l12 12M13 1L1 13" /></svg>
      </button>
    </div>
    <button id="menu-btn" class="pill-item header-link md:hidden cursor-pointer relative z-50" aria-label="Open menu">
      <svg id="icon-menu" width="16" height="12" viewBox="0 0 16 12" fill="none" stroke="currentColor" stroke-width="1.4"><path d="M0 1h16M0 6h16M0 11h16" /></svg>
      <svg id="icon-close" class="hidden" width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.4"><path d="M1 1l12 12M13 1L1 13" /></svg>
    </button>
  </div>

  <div id="menu-panel" aria-hidden="true">
    <div class="menu-bg"></div>
    <div class="menu-fade menu-topbar">
      <span class="menu-eyebrow">Explore</span>
      <button id="menu-close" type="button" aria-label="Close menu" class="menu-close cursor-pointer transition-opacity hover:opacity-60">
        <svg width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.4"><path d="M1 1l12 12M13 1L1 13" /></svg>
      </button>
    </div>
    <nav class="menu-primary">
      {NAV.menuPrimary.map((l) => (
        <a href={l.href} class="menu-primary-link"><span class="menu-mask"><span class="menu-line"><span class="menu-word">{l.label}</span><span class="menu-word" aria-hidden="true">{l.label}</span></span></span></a>
      ))}
    </nav>
    <nav class="menu-secondary">
      {NAV.menuSecondary.map((l) => (
        <a href={l.href} class="menu-secondary-link"><span class="menu-mask"><span class="menu-line">{l.label}</span></span></a>
      ))}
    </nav>
    <div class="menu-images">
      {NAV.menuImages.map((src) => <a href="/projects" class="menu-fade menu-image"><img src={src} alt="" loading="lazy" /></a>)}
    </div>
  </div>
</header>
